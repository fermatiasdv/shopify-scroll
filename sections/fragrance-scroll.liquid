<script
  src="{{ 'scroll-fragrance-scroll.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<link
  rel="preconnect"
  href="https://fonts.googleapis.com"
>
<link
  rel="preconnect"
  href="https://fonts.gstatic.com"
  crossorigin
>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&display=swap"
>

{%- liquid
  assign label_slugs = 'rebellious,forbidden_flower,wonder_of_the_world,jagged_edge,crimson_desert,glitterati,ecstasy,epicurean,london_legend' | split: ','
  # Pool de fondos BG1..BG15.png: cada transición sortea uno distinto (ver pickRandomBackground en scroll-styles.js).
  assign first_background = 'BG1.png' | asset_url
  # 3 variantes de imagen de ingrediente por fragancia (scroll-ingredient-<slug sin _>-<n>.webp);
  # scroll-content.js/styles.js sortean una cada vez que el ingrediente pasa a visible.
  assign ingredient_slugs = 'rebellious,wonder_of_the_world,painkiller,jagged_edge,glitterati,forbidden_flower,crimson_desert,ecstasy,epicurean,london_legend' | split: ','
-%}

<fragrance-scroll class="fragrance-scroll">
  <script type="application/json" data-fragrance-scroll-assets>
    {
      "model": {{ 'scroll-bottle.glb' | asset_url | json }},
      "labels": {
        "default": {{ 'scroll-bottle-label.png' | asset_url | json }}
        {%- for slug in label_slugs -%}
          {%- assign label_file = slug | remove: '_' | prepend: 'scroll-bottle-label-' | append: '.png' -%}
          , {{ slug | json }}: {{ label_file | asset_url | json }}
        {%- endfor %}
      },
      "backgrounds": [
        {%- for n in (1..15) -%}
          {%- assign background_file = 'BG' | append: n | append: '.png' -%}
          {{ background_file | asset_url | json }}{% unless forloop.last %}, {% endunless %}
        {%- endfor -%}
      ],
      "ingredients": {
        {%- for slug in ingredient_slugs -%}
          {%- assign ingredient_prefix = slug | remove: '_' | prepend: 'scroll-ingredient-' -%}
          {%- unless forloop.first %},{% endunless %}
          {{ slug | json }}: [
            {%- for n in (1..3) -%}
              {%- assign ingredient_file = ingredient_prefix | append: '-' | append: n | append: '.webp' -%}
              {{ ingredient_file | asset_url | json }}{% unless forloop.last %}, {% endunless %}
            {%- endfor -%}
          ]
        {%- endfor %}
      }
    }
  </script>

  <div
    class="fragrance-scroll__container"
    style="background-image: url('{{ first_background }}');"
  ></div>

  <div class="fragrances-overlay">
    <button
      type="button"
      class="fragrances-show-button"
    >
      {{ 'actions.show_fragrances' | t }}
      <span
        class="fragrances-show-arrow"
        aria-hidden="true"
        >&rarr;</span
      >
    </button>
  </div>

  <div
    class="background-overlay"
    aria-hidden="true"
  ></div>

  <button
    type="button"
    class="fragrances-close-button"
    aria-label="{{ 'actions.close' | t }}"
  >
    <span aria-hidden="true">&#10005;</span>
  </button>

  <button
    type="button"
    class="fragrances-buy-button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="fragrances-buy-drawer"
  >
    {{ 'actions.buy_it' | t }}
  </button>

  <div class="fragrances-drawer-root" hidden>
    <div
      class="fragrances-drawer-backdrop"
      aria-hidden="true"
    ></div>
    <aside
      id="fragrances-buy-drawer"
      class="fragrances-drawer"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'actions.buy_it' | t }}"
      tabindex="-1"
    >
      <button
        type="button"
        class="fragrances-drawer-close"
        aria-label="{{ 'actions.close' | t }}"
      >
        <span aria-hidden="true">&#10005;</span>
      </button>
    </aside>
  </div>
</fragrance-scroll>

{% stylesheet %}
  html.fragrance-scroll-animated,
  html.fragrance-scroll-animated body,
  html.fragrance-scroll-animated .page-wrapper {
    touch-action: none;
    overscroll-behavior: none;
  }

  /*
   * El stage fijo cubre el header nativo apoyado en z-index (19 contra 18), pero durante el
   * crossfade de fondo entre botellas las capas internas no siempre suman opacidad 1, así que por
   * un frame se puede transparentar y dejar ver el header por debajo. Ocultarlo directamente
   * mientras el modo animado está activo saca esa dependencia del timing del crossfade.
   */
  html.fragrance-scroll-animated .header-section {
    visibility: hidden;
  }

  .fragrance-scroll {
    display: block;
    position: relative;
    width: 100%;
    overflow: clip;
    font-family: 'Cormorant Garamond', serif;
  }

  .fragrance-scroll__container {
    width: 100%;
    height: var(--fragrance-scroll-page-height, 100vh);
    background-color: #1a0f08;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .fragrance-scroll-stage {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    width: var(--fragrance-scroll-viewport-width, 100%);
    z-index: calc(var(--layer-menu-drawer) + 1);
    overflow: hidden;
    isolation: isolate;
    pointer-events: none;
    font-family: 'Cormorant Garamond', serif;
  }

  html:not(.fragrance-scroll-animated) .fragrance-scroll-stage,
  html.fragrance-scroll-layers-hidden .fragrance-scroll-stage {
    display: none;
  }

  .fragrance-scroll-stage .background-transition-layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 2;
  }

  .fragrance-scroll-stage .background-transition-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity var(--fragrance-scroll-background-transition-ms) ease;
  }

  .fragrance-scroll .background-overlay {
    display: none;
  }

  .fragrance-scroll-stage .background-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
    background: rgb(0 0 0 / 0.6);
  }

  .fragrance-scroll-stage .display-layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 10;
  }

  .fragrance-scroll .collapsed-box-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
    background: rgb(0 0 0 / 0.6);
  }

  .fragrance-scroll .collapsed-box-content {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 10;
  }

  :is(.fragrance-scroll, .fragrance-scroll-stage) .display-item {
    position: absolute;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity var(--fragrance-scroll-label-transition-ms) ease,
      transform var(--fragrance-scroll-label-transition-ms) ease;
  }

  :is(.fragrance-scroll, .fragrance-scroll-stage) .display-label {
    color: #fff;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.2rem, 4vw, 2.5rem);
    line-height: normal;
    text-shadow: 0 2px 8px rgb(0 0 0 / 0.55), 0 1px 2px rgb(0 0 0 / 0.65);
  }

  :is(.fragrance-scroll, .fragrance-scroll-stage) .display-label-title {
    font-size: var(--fragrance-scroll-title-font-size);
    font-weight: 700;
    white-space: nowrap;
  }

  :is(.fragrance-scroll, .fragrance-scroll-stage) .display-label-ingredient {
    font-size: var(--fragrance-scroll-ingredient-font-size);
    font-weight: 400;
    white-space: nowrap;
  }

  :is(.fragrance-scroll, .fragrance-scroll-stage) .display-label-word {
    display: inline-block;
    opacity: 0;
    transition: opacity var(--fragrance-scroll-word-fade-ms) ease;
  }

  :is(.fragrance-scroll, .fragrance-scroll-stage) .display-image {
    width: auto;
    height: auto;
    max-width: 40vw;
    max-height: 40vh;
    object-fit: contain;
  }

  :is(.fragrance-scroll, .fragrance-scroll-stage) .display-image.display-image-product {
    display: block;
    max-width: none;
    max-height: none;
    pointer-events: auto;
  }

  :is(.fragrance-scroll, .fragrance-scroll-stage) .display-image-product[href] {
    cursor: pointer;
  }

  .fragrance-scroll .fragrances-overlay {
    position: absolute;
    inset: 0;
    /*
     * Por debajo de --layer-menu-drawer (18, ver .header-section) para que el botón "Show
     * fragrances" pase detrás del header al scrollear, en vez de taparlo.
     */
    z-index: calc(var(--layer-menu-drawer) - 1);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 8vh;
    pointer-events: none;
  }

  .fragrance-scroll .fragrances-show-button {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0.9rem 1.6rem;
    border: none;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.75);
    color: #fff;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.03em;
    cursor: pointer;
  }

  .fragrance-scroll .fragrances-show-arrow {
    font-size: 1.2rem;
    line-height: 1;
    transform: translateY(-1px);
  }

  .fragrances-close-button {
    display: none;
  }

  .fragrance-scroll-stage .fragrances-close-button {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.75);
    color: #fff;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    pointer-events: auto;
  }

  .fragrances-buy-button,
  .fragrances-drawer-root {
    display: none;
  }

  .fragrance-scroll-stage .fragrances-buy-button {
    position: absolute;
    bottom: 8vh;
    left: 50%;
    z-index: 20;
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 0.9rem 1.6rem;
    border: none;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.75);
    color: #fff;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.03em;
    cursor: pointer;
    pointer-events: auto;
    transform: translateX(-50%);
  }

  .fragrance-scroll-stage .fragrances-drawer-root {
    position: absolute;
    inset: 0;
    z-index: 30;
    display: block;
    overflow: clip;
    contain: layout paint;
    pointer-events: none;
  }

  .fragrance-scroll-stage .fragrances-drawer-root[hidden] {
    display: none;
  }

  .fragrance-scroll-stage .fragrances-drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.5);
    opacity: 0;
    transition: opacity 0.3s ease;
    will-change: opacity;
    pointer-events: auto;
  }

  .fragrance-scroll-stage .fragrances-drawer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    background: #fff;
    color: #1a0f08;
    font-family: 'Cormorant Garamond', serif;
    overflow-y: auto;
    overscroll-behavior: contain;
    pointer-events: auto;
    transform: translate3d(100%, 0, 0);
    transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
    will-change: transform;
  }

  .fragrance-scroll-stage .fragrances-drawer-root.is-open .fragrances-drawer-backdrop {
    opacity: 1;
  }

  .fragrance-scroll-stage .fragrances-drawer-root.is-open .fragrances-drawer {
    transform: translate3d(0, 0, 0);
  }

  .fragrance-scroll-stage .fragrances-drawer-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.75);
    color: #fff;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }

  @media screen and (min-width: 750px) {
    .fragrance-scroll-stage .fragrances-drawer {
      width: min(28rem, 100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fragrance-scroll-stage .fragrances-drawer,
    .fragrance-scroll-stage .fragrances-drawer-backdrop {
      transition: none;
    }
  }

  html.fragrance-scroll-animated .fragrance-scroll .fragrances-overlay,
  html.fragrance-scroll-layers-hidden .fragrance-scroll .fragrances-overlay {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.fragrance_scroll",
  "tag": "section",
  "class": "fragrance-scroll-section",
  "limit": 1,
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [],
  "presets": [
    {
      "name": "t:names.fragrance_scroll",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
